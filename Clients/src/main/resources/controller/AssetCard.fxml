<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane onMouseClicked="#on_choice" prefHeight="280.0" prefWidth="210.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ItemCardController">
   <children>
      <VBox alignment="TOP_CENTER" spacing="8.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <VBox alignment="CENTER" prefHeight="140.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10 10 0 0;">
               <children>
                  <ImageView fx:id="j_img" fitHeight="130.0" fitWidth="190.0" pickOnBounds="true" preserveRatio="true" />
               </children>
               <VBox.margin>
                  <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
               </VBox.margin>
            </VBox>

            <VBox spacing="5.0">
               <padding>
                  <Insets left="12.0" right="12.0" />
               </padding>
               <children>
                  <Label fx:id="j_name" prefHeight="45.0" prefWidth="186.0" text="Tên sản phẩm đấu giá" textFill="#2b3442" wrapText="true">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>

                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Giá:" textFill="#757575">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                        <Label fx:id="j_StartPrice" text="0 VNĐ" textFill="#4caf50">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <AnchorPane prefHeight="1.0" style="-fx-background-color: #e0e0e0;">
               <VBox.margin>
                  <Insets left="12.0" right="12.0" />
               </VBox.margin>
            </AnchorPane>

            <VBox spacing="2.0">
               <padding>
                  <Insets bottom="10.0" left="12.0" right="12.0" />
               </padding>
               <children>
                  <Label fx:id="j_status" text="Trạng thái: --" textFill="#1e88e5">
                     <font>
                        <Font name="System Bold" size="11.0" />
                     </font>
                  </Label>
                  <Label fx:id="j_StartTime" text="Bắt đầu: --/--/--" textFill="#757575">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
                  <Label fx:id="j_EndTime" text="Kết thúc: --/--/--" textFill="#757575">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
   <cursor>
      <Cursor fx:constant="HAND" />
   </cursor>
</AnchorPane>