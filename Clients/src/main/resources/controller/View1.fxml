<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ControllerLogin" style="-fx-background-color: #f4f4f4;">
   <children>
      <VBox alignment="CENTER" prefHeight="450.0" prefWidth="320.0" style="-fx-background-color: #2c3e50;">
         <children>
            <Label text="AUCTION" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="36.0" />
               </font>
            </Label>
            <Label text="Online System" textFill="#ecf0f1">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Button fx:id="jbutton_DangKy" mnemonicParsing="false" onAction="#setJbutton_DangKy" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 20;" text="ĐĂNG KÝ NGAY" textFill="WHITE" translateY="50.0">
               <padding>
                  <Insets bottom="8.0" left="25.0" right="25.0" top="8.0" />
               </padding>
            </Button>
         </children>
      </VBox>

      <VBox alignment="CENTER_LEFT" prefHeight="450.0" prefWidth="430.0" spacing="15.0" style="-fx-background-color: white;">
         <children>
            <Label text="Đăng Nhập Hệ Thống" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>

            <VBox spacing="5.0">
               <children>
                  <Label text="Tên đăng nhập" textFill="#7f8c8d" />
                  <TextField fx:id="username"  prefHeight="40.0" promptText="Nhập username..." style="-fx-background-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Mật khẩu" textFill="#7f8c8d" />
                  <PasswordField fx:id="password" prefHeight="40.0" promptText="Nhập mật khẩu..." style="-fx-background-radius: 5;" />
               </children>
            </VBox>

            <Label fx:id="errorLabel" text="Thông báo lỗi tại đây" textFill="#e74c3c" visible="false" />

            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Button fx:id="jbutton_DangNhap" mnemonicParsing="false" onAction="#handleRegister" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #3498db; -fx-background-radius: 20; -fx-cursor: hand;" text="Đăng nhập" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
                  <Hyperlink text="Quên mật khẩu?" textFill="#3498db" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets left="50.0" right="50.0" />
         </padding>
      </VBox>
   </children>
</HBox>