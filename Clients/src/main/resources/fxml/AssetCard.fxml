<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="cardRoot" onMouseClicked="#on_choice" prefHeight="280.0" prefWidth="210.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(15,23,42,0.12), 10, 0, 0, 5);" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ItemCardController">
   <children>
      <Label fx:id="lblBadge" text="HOT" visible="false" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 9px; -fx-padding: 3 8 3 8; -fx-background-radius: 8;" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
      <VBox alignment="TOP_CENTER" spacing="8.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <VBox alignment="CENTER" prefHeight="140.0" style="-fx-background-color: linear-gradient(to bottom right, #f8fbff, #eef4ff, #f7f3ff); -fx-background-radius: 14 14 0 0;">
               <children>
                  <ImageView fx:id="j_img" fitHeight="130.0" fitWidth="190.0" pickOnBounds="true" preserveRatio="true" />
               </children>
               <VBox.margin>
                  <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
               </VBox.margin>
            </VBox>

            <VBox spacing="5.0">
               <padding>
                  <Insets left="12.0" right="12.0" />
               </padding>
               <children>
                  <Label fx:id="j_name" prefHeight="45.0" prefWidth="186.0" text="Tên sản phẩm đấu giá" textFill="#111827" wrapText="true">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>

                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Giá:" textFill="#64748b">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                        <Label fx:id="j_StartPrice" text="0 VNĐ" textFill="#16a34a">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <AnchorPane prefHeight="1.0" style="-fx-background-color: #e5eaf2;">
               <VBox.margin>
                  <Insets left="12.0" right="12.0" />
               </VBox.margin>
            </AnchorPane>

            <VBox spacing="2.0">
               <padding>
                  <Insets bottom="10.0" left="12.0" right="12.0" />
               </padding>
               <children>
                  <Label fx:id="j_status" text="Trạng thái: --" textFill="#2563eb">
                     <font>
                        <Font name="System Bold" size="11.0" />
                     </font>
                  </Label>
                  <Label fx:id="j_StartTime" text="Bắt đầu: --/--/--" textFill="#64748b">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
                  <Label fx:id="j_EndTime" text="Kết thúc: --/--/--" textFill="#64748b">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
   <cursor>
      <Cursor fx:constant="HAND" />
   </cursor>
</AnchorPane>