<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="Pane1" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #f8fbff, #eef4ff, #f7f3ff);"
            xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ControllerEditProduct">
    <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">

        <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="15.0"
              style="-fx-background-color: #ffffff; -fx-effect: dropshadow(three-pass-box, rgba(15,23,42,0.12), 10, 0, 0, 0);">
            <Label text="BẢNG ĐIỀU KHIỂN">
                <font>
                    <Font name="System Bold" size="18.0"/>
                </font>
                <VBox.margin>
                    <Insets bottom="20.0" top="20.0"/>
                </VBox.margin>
            </Label>
            <ImageView fx:id="j_image" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                <cursor>
                    <Cursor fx:constant="HAND"/>
                </cursor>
                <Image url="@../img/imgUSER.png"/>
            </ImageView>
            <Label fx:id="j_LabelName" text="Tên người dùng" textFill="#111827">
                <font>
                    <Font name="System Bold" size="16.0"/>
                </font>
            </Label>
            <HBox alignment="CENTER" spacing="5.0">
                <Label text="Số dư:" textFill="#64748b"/>
                <Label fx:id="j_textSoDu" text="0.0 VNĐ" textFill="#dc2626">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Label>
            </HBox>
            <Separator prefWidth="200.0">
                <VBox.margin>
                    <Insets bottom="20.0" top="20.0"/>
                </VBox.margin>
            </Separator>
            <VBox VBox.vgrow="ALWAYS"/>
<!-- Nút Quay lại danh sách. -->
<Button fx:id="btnProductList" mnemonicParsing="false" onAction="#On_Back" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 16;" text="Quay lại danh sách">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>
<!-- Nút Đăng xuất. -->
<Button fx:id="LogOut" mnemonicParsing="false" onAction="#On_LogOut" prefHeight="40.0" prefWidth="180.0"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 16;"
                    text="Đăng xuất">
                <font>
                    <Font name="System Bold" size="13.0"/>
                </font>
                <VBox.margin>
                    <Insets bottom="30.0"/>
                </VBox.margin>
            </Button>
        </VBox>

        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="CẬP NHẬT THÔNG TIN SẢN PHẨM" textFill="#111827">
                     <font>
                        <Font name="System Bold" size="24.0"/>
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label fx:id="connectionText" text="Offline" textFill="#64748b">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                        <Circle fx:id="connectionStatus" fill="#ef4444" radius="5.0" stroke="#0f172a" strokeType="INSIDE" strokeWidth="0.5" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                <VBox spacing="12.0" HBox.hgrow="ALWAYS">

                    <VBox spacing="5.0">
                        <HBox spacing="3.0">
                            <Label text="Tên sản phẩm" textFill="#111827">
                                <font>
                                    <Font name="System Bold" size="13.0"/>
                                </font>
                            </Label>
                        </HBox>
                        <TextField fx:id="txtName" prefHeight="40.0" promptText="Nhập tên sản phẩm"
                                   style="-fx-background-radius: 12;"/>
                    </VBox>

                    <HBox spacing="10.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Bắt đầu" textFill="#64748b"/>
                            <DatePicker fx:id="dpStartDate" prefHeight="35.0" prefWidth="200.0" promptText="Ngày"/>
                            <TextField fx:id="txtTimeStart" prefHeight="35.0" text="00:00:00"/>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Kết thúc" textFill="#64748b"/>
                            <DatePicker fx:id="dpEndDate" prefHeight="35.0" prefWidth="200.0" promptText="Ngày"/>
                            <TextField fx:id="txtTimeEnd" prefHeight="35.0" text="23:59:59"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5.0">
                        <Label text="Giá khởi điểm (VNĐ)" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="txtStartPrice" prefHeight="40.0" promptText="Ví dụ: 200000"/>
                        <Label text="MinBid (VNĐ) - tối đa 20% giá khởi điểm" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="txtMinBid" prefHeight="40.0" promptText="MinBid - không quá 20% giá khởi điểm"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Mô tả gốc của sản phẩm" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <TextArea fx:id="txtDescription" prefHeight="100.0" promptText="Mô tả chi tiết sản phẩm..." wrapText="true"/>
                    </VBox>

                    <VBox fx:id="vboxAppendNote" spacing="5.0" visible="false" managed="false">
                        <Label fx:id="lblAppendNoteTitle" text="Bổ sung thông tin sửa đổi (Sản phẩm đang đấu giá)" textFill="#f59e0b">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <TextArea fx:id="txtAppendNote" prefHeight="60.0" promptText="Nhập nội dung bổ sung thông tin tại đây..." style="-fx-border-color: #f59e0b; -fx-border-radius: 12;" wrapText="true"/>
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <ComboBox fx:id="j_ItemType" prefHeight="35.0" prefWidth="150.0" promptText="Loại mặt hàng"/>
                        <AnchorPane>
                            <HBox fx:id="j_paneVehicle" spacing="10.0" visible="false" managed="false">
                                <TextField fx:id="j_manufacturer" prefHeight="35.0" promptText="Nhà sản xuất"/>
                                <TextField fx:id="j_year" prefHeight="35.0" promptText="Năm sản xuất"/>
                            </HBox>
                            <HBox fx:id="j_paneElectronics" spacing="10.0" visible="false" managed="false">
                                <TextField fx:id="j_brand" prefHeight="35.0" promptText="Thương hiệu"/>
                                <TextField fx:id="j_model" prefHeight="35.0" promptText="Model"/>
                            </HBox>
                            <HBox fx:id="j_paneArt" spacing="10.0" visible="false" managed="false">
                                <TextField fx:id="j_artist" prefHeight="35.0" promptText="Tên tác giả"/>
                            </HBox>
                        </AnchorPane>
                    </HBox>
                </VBox>

                <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="15.0">
                    <Label text="Hình ảnh sản phẩm" textFill="#64748b"/>
                    <AnchorPane style="-fx-border-color: #d7e0ef; -fx-border-radius: 14; -fx-background-color: white; -fx-background-radius: 14;">
                        <ImageView fx:id="MyImgView" fitHeight="200.0" fitWidth="200.0" layoutX="10.0"
                                   layoutY="10.0" pickOnBounds="true" preserveRatio="true"
                                   AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0"
                                   AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0"/>
                    </AnchorPane>
<!-- Nút Đổi ảnh mới. -->
<Button fx:id="btnUploadImage" mnemonicParsing="false" onAction="#handle_SelectImage" prefHeight="35.0"
                            prefWidth="120.0" style="-fx-background-color: #334155; -fx-text-fill: white;"
                            text="Đổi ảnh mới"/>
                </VBox>
            </HBox>

            <Separator prefWidth="200.0"/>

            <HBox alignment="CENTER_LEFT" spacing="20.0">
<!-- Nút LƯU THAY ĐỔI. -->
<Button fx:id="btnSave" mnemonicParsing="false" onAction="#On_Save" prefHeight="50.0"
                        prefWidth="250.0"
                        style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 12;"
                        text="LƯU THAY ĐỔI">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </Button>
                <Label fx:id="error_Label" text="Thông báo lỗi tại đây" textFill="#dc2626" visible="false">
                    <font>
                        <Font name="System Italic" size="13.0"/>
                    </font>
                </Label>
            </HBox>
        </VBox>
    </HBox>
</AnchorPane>
