<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="Pane1" prefHeight="650.0" prefWidth="850.0" style="-fx-background-color: linear-gradient(to bottom right, #f8fbff, #eef4ff, #f7f3ff);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ControllerPayment">

   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #ffffff; -fx-effect: dropshadow(three-pass-box, rgba(15,23,42,0.12), 10, 0, 0, 2);" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
         <children>
            <ImageView fx:id="j_image" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../img/imgUSER.png" />
               </image>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </ImageView>
            <VBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="343.0">
               <padding>
                  <Insets left="15.0" />
               </padding>
               <children>
                  <Label fx:id="j_LabelName" text="Username" textFill="#111827">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_LEFT" prefHeight="20.0" prefWidth="239.0" spacing="5.0">
                     <children>
                        <Label text="Số dư:" textFill="#64748b" />
                        <Label fx:id="j_textSoDu" prefHeight="20.0" prefWidth="281.0" text="0.0 VNĐ" textFill="#16a34a">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="THANH TOÁN ĐƠN HÀNG" textFill="#111827" style="-fx-font-weight: 900;">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>

   <center>
      <HBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>

            <VBox prefWidth="450.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(15,23,42,0.08), 10, 0, 0, 5);">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Thông tin sản phẩm trúng đấu giá" textFill="#64748b">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <ImageView fx:id="j_img" fitHeight="250.0" fitWidth="410.0" pickOnBounds="true" preserveRatio="true" />
                  <Label fx:id="j_name" text="Tên sản phẩm" textFill="#111827" wrapText="true">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: white;" VBox.vgrow="ALWAYS">
                     <content>
                        <Label fx:id="j_description" text="Mô tả chi tiết sản phẩm sẽ hiện ở đây..." textFill="#475569" wrapText="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                        </Label>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <VBox alignment="TOP_CENTER" prefWidth="320.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(15,23,42,0.08), 10, 0, 0, 5);">
               <padding>
                  <Insets bottom="30.0" left="25.0" right="25.0" top="30.0" />
               </padding>
               <children>
                  <Label text="Hóa Đơn Thanh Toán" textFill="#111827">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>

                  <Region prefHeight="10.0" />

                  <VBox alignment="CENTER" prefHeight="100.0" prefWidth="100.0" spacing="10.0" style="-fx-background-color: #fff7ed; -fx-background-radius: 14;">
                     <children>
                        <Label text="Số tiền cần thanh toán" textFill="#f97316">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="j_CurrentPrice" text="0 VNĐ" textFill="#f97316">
                           <font>
                              <Font name="System Bold" size="26.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>

                  <Label fx:id="j_status" text="Trạng thái: Chờ thanh toán" textFill="#64748b">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>

                  <Region VBox.vgrow="ALWAYS" />

                  <Label fx:id="j_notified" textAlignment="CENTER" textFill="#dc2626" visible="false" wrapText="true">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>

                  <Button fx:id="j_apply" maxWidth="Infinity" mnemonicParsing="false" onAction="#On_apply" prefHeight="45.0" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 12;" text="XÁC NHẬN THANH TOÁN">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>

                  <HBox maxWidth="Infinity" spacing="10.0">
                     <children>
                        <Button fx:id="j_return" maxWidth="Infinity" mnemonicParsing="false" onAction="#On_Return" prefHeight="40.0" style="-fx-background-color: transparent; -fx-border-color: #94a3b8; -fx-border-radius: 12; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Về Sảnh" HBox.hgrow="ALWAYS">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                        <Button fx:id="j_return_history" maxWidth="Infinity" mnemonicParsing="false" onAction="#On_Return_History" prefHeight="40.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12;" text="Lịch sử" HBox.hgrow="ALWAYS">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                     </children>
                  </HBox>

               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
