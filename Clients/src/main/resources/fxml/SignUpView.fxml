<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ControllerRegister">
   <children>
      <VBox alignment="CENTER" prefHeight="500.0" prefWidth="300.0" spacing="20.0" styleClass="left-panel">
         <children>
            <Label styleClass="brand-title" text="ĐĂNG KÝ" />
            <Label styleClass="brand-subtitle" text="Tham gia sàn đấu giá ngay hôm nay" textAlignment="CENTER" wrapText="true">
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
            </Label>
            <Button fx:id="jbuton_TrangChu" mnemonicParsing="false" onAction="#setJbutton_TrangChu" styleClass="btn-outline" text="QUAY LẠI ĐĂNG NHẬP">
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>

      <VBox alignment="CENTER" prefHeight="500.0" prefWidth="500.0" spacing="12.0" styleClass="right-panel">
         <children>
            <Label styleClass="form-title" text="Tạo tài khoản mới">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>

            <TextField fx:id="username_DK" onAction="#resetStyle" prefHeight="35.0" promptText="Tên đăng nhập" styleClass="custom-input" />

            <HBox spacing="10.0">
               <children>
                  <PasswordField fx:id="password_DK1" onAction="#resetStyle" prefHeight="35.0" prefWidth="250.0" promptText="Mật khẩu" styleClass="custom-input" />
                  <PasswordField fx:id="password_DK2" onAction="#resetStyle" prefHeight="35.0" prefWidth="250.0" promptText="Nhập lại mật khẩu" styleClass="custom-input" />
               </children>
            </HBox>

            <TextField fx:id="name" onAction="#resetStyle" onKeyTyped="#resetStyle" prefHeight="35.0" promptText="Họ và tên" styleClass="custom-input" />
            <TextField fx:id="address" onAction="#resetStyle" onKeyTyped="#resetStyle" prefHeight="35.0" promptText="Địa chỉ Email" styleClass="custom-input" />

            <VBox spacing="5.0">
               <children>
                  <Label styleClass="input-label" text="Bạn tham gia với vai trò:" />
                  <ComboBox fx:id="jComboBox_Role" prefHeight="35.0" prefWidth="400.0" promptText="-- Chọn vai trò --" styleClass="custom-input" />
               </children>
            </VBox>

            <Label fx:id="errorLabel1" styleClass="error-text" text="Thông báo lỗi" visible="false" />

            <Button fx:id="jbuton_GhiNhanDangKy" mnemonicParsing="false" onAction="#handleRegister_DangKy" prefHeight="40.0" prefWidth="180.0" styleClass="btn-primary" text="HOÀN TẤT ĐĂNG KÝ">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</HBox>