<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="Pane1" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f4f7f6;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ControllerSeller">
   <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
         AnchorPane.topAnchor="0.0">
      <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="15.0"
            style="-fx-background-color: #ffffff; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
         <Label text="BẢNG ĐIỀU KHIỂN">
            <font>
               <Font name="System Bold" size="18.0"/>
            </font>
            <VBox.margin>
               <Insets bottom="20.0" top="20.0"/>
            </VBox.margin>
         </Label>
         <ImageView fx:id="j_image" fitHeight="100.0" fitWidth="100.0" onMouseClicked="#On_MouseClickImg"
                    pickOnBounds="true" preserveRatio="true">
            <cursor>
               <Cursor fx:constant="HAND"/>
            </cursor>
            <Image url="@../img/imgUSER.png"/>
         </ImageView>
         <Label fx:id="j_LabelName" text="Tên người dùng" textFill="#2c3e50">
            <font>
               <Font name="System Bold" size="16.0"/>
            </font>
         </Label>
         <HBox alignment="CENTER" spacing="5.0">
            <Label text="Số dư:" textFill="#7f8c8d"/>
            <Label fx:id="j_textSoDu" text="0.0 VNĐ" textFill="#e74c3c">
               <font>
                  <Font name="System Bold" size="14.0"/>
               </font>
            </Label>
         </HBox>
         <Separator prefWidth="200.0">
            <VBox.margin>
               <Insets bottom="20.0" top="20.0"/>
            </VBox.margin>
         </Separator>
         <VBox VBox.vgrow="ALWAYS"/>
         <Button fx:id="LogOut" mnemonicParsing="false" onAction="#On_LogOut" prefHeight="40.0" prefWidth="180.0"
                 style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 20;"
                 text="Đăng xuất">
            <font>
               <Font name="System Bold" size="13.0"/>
            </font>
            <VBox.margin>
               <Insets bottom="30.0"/>
            </VBox.margin>
         </Button>
      </VBox>

      <VBox spacing="20.0" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
         </padding>
         <Label text="ĐĂNG SẢN PHẨM MỚI" textFill="#2c3e50">
            <font>
               <Font name="System Bold" size="24.0"/>
            </font>
         </Label>

         <HBox spacing="30.0" VBox.vgrow="ALWAYS">
            <VBox spacing="15.0" HBox.hgrow="ALWAYS">
               <VBox spacing="5.0">
                  <HBox spacing="3.0">
                     <Label text="Tên sản phẩm" textFill="#2c3e50">
                        <font>
                           <Font name="System Bold" size="13.0"/>
                        </font>
                     </Label>
                     <Label text="*" textFill="#e74c3c">
                        <font>
                           <Font name="System Bold" size="13.0"/>
                        </font>
                     </Label>
                  </HBox>
                  <TextField fx:id="j_name" prefHeight="40.0" promptText="Nhập tên sản phẩm"
                             style="-fx-background-radius: 5;"/>
               </VBox>

               <HBox spacing="10.0">
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <HBox spacing="3.0">
                        <Label text="Bắt đầu" textFill="#7f8c8d"/>
                        <Label text="*" textFill="#e74c3c">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                     </HBox>
                     <DatePicker fx:id="j_DateStart" prefHeight="35.0" prefWidth="200.0"
                                 promptText="Ngày"/>
                     <TextField fx:id="j_TimeStart" prefHeight="35.0" text="00:00:00"/>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <HBox spacing="3.0">
                        <Label text="Kết thúc" textFill="#7f8c8d"/>
                        <Label text="*" textFill="#e74c3c">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                     </HBox>
                     <DatePicker fx:id="j_DateEnd" prefHeight="35.0" prefWidth="200.0"
                                 promptText="Ngày"/>
                     <TextField fx:id="j_TimeEnd" prefHeight="35.0" text="23:59:59"/>
                  </VBox>
               </HBox>

               <VBox spacing="5.0">
                  <HBox spacing="3.0">
                     <Label text="Giá khởi điểm (VNĐ)" textFill="#2c3e50">
                        <font>
                           <Font name="System Bold" size="13.0"/>
                        </font>
                     </Label>
                     <Label text="*" textFill="#e74c3c">
                        <font>
                           <Font name="System Bold" size="13.0"/>
                        </font>
                     </Label>
                  </HBox>
                  <TextField fx:id="j_StartingPrice" prefHeight="40.0" promptText="Ví dụ: 200000"/>
               </VBox>

               <TextArea fx:id="j_description" prefHeight="150.0" promptText="Mô tả chi tiết sản phẩm..."
                         wrapText="true"/>

               <HBox alignment="CENTER_LEFT" spacing="20.0">
                  <ComboBox fx:id="j_ItemType" onAction="#handle_Info" prefHeight="35.0"
                            prefWidth="150.0" promptText="Loại mặt hàng"/>

                  <AnchorPane>
                     <HBox fx:id="j_paneVehicle" spacing="10.0" visible="false">
                        <TextField fx:id="j_manufacturer" prefHeight="35.0"
                                   promptText="Nhà sản xuất"/>
                        <TextField fx:id="j_year" prefHeight="35.0" promptText="Năm sản xuất"/>
                     </HBox>
                     <HBox fx:id="j_paneElectronics" spacing="10.0" visible="false">
                        <TextField fx:id="j_brand" prefHeight="35.0" promptText="Thương hiệu"/>
                        <TextField fx:id="j_model" prefHeight="35.0" promptText="Model"/>
                     </HBox>
                     <HBox fx:id="j_paneArt" spacing="10.0">
                        <TextField fx:id="j_artist" prefHeight="35.0" promptText="Tên tác giả"/>
                     </HBox>
                  </AnchorPane>
               </HBox>
            </VBox>

            <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="15.0">
               <Label text="Hình ảnh sản phẩm" textFill="#7f8c8d"/>
               <AnchorPane
                       style="-fx-border-color: #bdc3c7; -fx-border-radius: 10; -fx-background-color: white; -fx-background-radius: 10;">
                  <ImageView fx:id="MyImgView" fitHeight="200.0" fitWidth="200.0" layoutX="10.0"
                             layoutY="10.0" pickOnBounds="true" preserveRatio="true"
                             AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0"
                             AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0"/>
               </AnchorPane>
               <Button mnemonicParsing="false" onAction="#handle_SelectImage" prefHeight="35.0"
                       prefWidth="120.0" style="-fx-background-color: #34495e; -fx-text-fill: white;"
                       text="Chọn ảnh"/>
            </VBox>
         </HBox>

         <Separator prefWidth="200.0"/>

         <HBox alignment="CENTER_LEFT" spacing="20.0">
            <Button fx:id="j_ApplyItem" mnemonicParsing="false" onAction="#handle_Items" prefHeight="50.0"
                    prefWidth="250.0"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 5;"
                    text="ĐĂNG SẢN PHẨM NGAY">
               <font>
                  <Font name="System Bold" size="16.0"/>
               </font>
               <cursor>
                  <Cursor fx:constant="HAND"/>
               </cursor>
            </Button>
            <Label fx:id="error_Label" text="Thông báo lỗi tại đây" textFill="#e74c3c" visible="false">
               <font>
                  <Font name="System Italic" size="13.0"/>
               </font>
            </Label>
         </HBox>
      </VBox>
   </HBox>
</AnchorPane>